# ============================================================
#  Mystica —  环境变量模板 (.env.example)
#  用法: 复制本文件为 .env, 填入真实值。切勿把 .env 提交到 Git!
#  部署平台 (Vercel / Cloudflare / Railway) 请在其后台"环境变量"里配置同名变量。
# ============================================================

# ---------- 基础 ----------
PORT=8080
# 你的正式域名 (用于支付回跳、SEO、邮件里的链接)。上线后改成 https://mystica.app
PUBLIC_URL=http://localhost:8080

# ---------- AI 生成 (深度报告的灵魂) ----------
# 沙盒里会自动读取 ~/.genspark_llm.yaml; 自有服务器请填下面两项。
# 支持任何 OpenAI 兼容接口 (OpenAI 官方 / Azure / 国产中转)。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
# 报告模型 (质量优先用 gpt-5-mini / gpt-4o; 每日一句用便宜的 nano)
MODEL_DEEP=gpt-5-mini
MODEL_DAILY=gpt-5-nano

# ============================================================
#  支付 —— 这是"收钱"的开关。默认 demo(不真扣款, 用于演示)。
#  上线收款请改成 lemonsqueezy(强烈推荐, 海外) 或 stripe。
# ============================================================
PAYMENT_PROVIDER=demo          # demo | lemonsqueezy | stripe

# ---------- 方案 A: Lemon Squeezy (推荐 —— Merchant of Record, 自动全球代扣增值税/销售税) ----------
# 注册: https://www.lemonsqueezy.com  → Settings → API 创建 API Key
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# 在 Lemon 后台为每个产品建一个 Variant, 把 variant id 填到对应变量:
LEMONSQUEEZY_VARIANT_DEEP=
LEMONSQUEEZY_VARIANT_COMPAT=
LEMONSQUEEZY_VARIANT_NAMING=
LEMONSQUEEZY_VARIANT_DATES=
LEMONSQUEEZY_VARIANT_SCROLL=
LEMONSQUEEZY_VARIANT_AMULET=
LEMONSQUEEZY_VARIANT_MEMBER=

# ---------- 方案 B: Stripe (若你已有 Stripe 账户) ----------
# 注意: Stripe 不代扣税, 跨境需自行处理税务。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEEP=
STRIPE_PRICE_COMPAT=
STRIPE_PRICE_NAMING=
STRIPE_PRICE_DATES=
STRIPE_PRICE_SCROLL=
STRIPE_PRICE_AMULET=
STRIPE_PRICE_MEMBER=

# ============================================================
#  增长 / 分析 (选填, 但强烈建议上线首日就装)
# ============================================================
# Google Analytics 4 衡量ID (G-XXXXXXX)
GA_MEASUREMENT_ID=
# TikTok Pixel (投流回收关键)
TIKTOK_PIXEL_ID=
# Meta / Facebook Pixel
META_PIXEL_ID=

# ---------- 邮件 (弃单召回 / 名单变现, 选填) ----------
# 推荐 Resend (便宜好用) 或 SendGrid
RESEND_API_KEY=
EMAIL_FROM=hello@mystica.app
